{
  "manifest_version": 3,
  "name": "OpenDownload Integration",
  "version": "0.4.4",
  "description": "Send links and optional browser downloads to the free OpenDownload desktop app.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "downloads",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenDownload",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
