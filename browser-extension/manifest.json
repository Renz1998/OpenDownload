{
  "manifest_version": 3,
  "name": "OpenDownload Integration",
  "version": "0.2.0",
  "description": "Send links and optional browser downloads to the free OpenDownload desktop app.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "downloads",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenDownload"
  },
  "key": ""
}
