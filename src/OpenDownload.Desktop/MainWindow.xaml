<Window x:Class="OpenDownload.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="OpenDownload" Width="1260" Height="840" MinWidth="850" MinHeight="600" Closing="WindowClosing">
 <Window.Resources><DataTemplate x:Key="MoreIcon"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Ellipse Width="4" Height="4" Canvas.Left="2" Canvas.Top="10" Fill="{DynamicResource Ink}"/><Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="10" Fill="{DynamicResource Ink}"/><Ellipse Width="4" Height="4" Canvas.Left="18" Canvas.Top="10" Fill="{DynamicResource Ink}"/></Canvas></Viewbox></DataTemplate>
  <Style x:Key="TransferProgress" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Needs attention"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Needs attention"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style>
  <DataTemplate x:Key="FocusRow"><Border Padding="18" Margin="0,0,0,12" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/><TextBlock Text="{Binding Subtitle, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{Binding ActionLabel, Mode=OneWay}" Click="RowActionClick" Tag="{Binding}"/><Button ContentTemplate="{StaticResource MoreIcon}" Click="RowMoreClick" Tag="{Binding}" AutomationProperties.Name="More download actions"/></StackPanel></Grid><ProgressBar Style="{StaticResource TransferProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,15,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource StatusText}" Text="{Binding Status, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding TransferSummary, Mode=OneWay}" FontSize="12"/></Grid></StackPanel></Border></DataTemplate>
 </Window.Resources>
 <DockPanel Background="{DynamicResource Canvas}">
  <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" Padding="20,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="BrandIcon.png" Width="34" Height="34" Margin="0,0,10,0"/><TextBlock Text="OpenDownload" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="VersionLabel" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="LayoutButton" Content="Workbench ▾" Click="LayoutClick" ToolTip="Switch between Workbench and Focus"/><Button x:Name="GlobalSettingsButton" Content="Settings" Click="OptionsClick" Style="{StaticResource QuietButton}"/><Button Content="Light / Dark" Click="ThemeClick" Style="{StaticResource QuietButton}"/><Button Content="Exit" Click="ExitClick" Style="{StaticResource QuietButton}" ToolTip="Pause downloads and exit the app"/></StackPanel></Grid></Border>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" Padding="16,9" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Summary" Text="Ready" FontSize="12"/><TextBlock x:Name="LimitStatus" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="LocationLabel" Content="Downloads folder" Click="DefaultFolderClick" Style="{StaticResource QuietButton}"/><Button Click="OptionsClick" Style="{StaticResource QuietButton}"><TextBlock x:Name="ScheduleStatus" Text="Schedule off"/></Button></StackPanel></Grid></Border>
  <Border x:Name="NoticeBar" DockPanel.Dock="Bottom" Background="{DynamicResource Selected}" Padding="16,9" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Click="DismissNoticeClick" AutomationProperties.Name="Dismiss notification" Style="{StaticResource QuietButton}"/><Button DockPanel.Dock="Right" x:Name="UndoButton" Content="Undo" Click="UndoClick"/><TextBlock x:Name="Notice" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="185"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border x:Name="LibrarySidebar" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="12,22"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Button x:Name="BrowserStatus" Content="Connect browser" Click="BrowserClick" HorizontalContentAlignment="Left"/><Button Content="Settings" Click="OptionsClick" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"/></StackPanel><StackPanel><TextBlock Text="LIBRARY" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,0,0,12"/><ListBox x:Name="Categories" SelectedIndex="0" SelectionChanged="CategoryChanged"><ListBoxItem Content="All downloads"/><ListBoxItem Content="Downloading"/><ListBoxItem Content="Paused"/><ListBoxItem Content="Needs attention"/><ListBoxItem Content="Completed"/><ListBoxItem Content="AI models"/><ListBoxItem Content="Archives"/><ListBoxItem Content="Video"/><ListBoxItem Content="Music"/><ListBoxItem Content="Programs"/><ListBoxItem Content="Documents"/><ListBoxItem Content="Other"/></ListBox></StackPanel></DockPanel></Border>
   <DockPanel Grid.Column="1" Margin="24,22">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR LIBRARY" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="LibraryTitle" Text="All downloads" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" AutomationProperties.Name="Add download" Click="AddClick" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" ToolTip="Add one URL or a batch (Ctrl+N)"><StackPanel Orientation="Horizontal"><Path Data="M 7,0 L 7,14 M 0,7 L 14,7" Stroke="{DynamicResource AccentInk}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Add download"/></StackPanel></Button></Grid>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="SearchChanged" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Search downloads" AutomationProperties.Name="Search downloads"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Pause all" Click="PauseAllClick"/><Button x:Name="GamingButton" Content="Gaming mode" Click="GamingClick"/></StackPanel></Grid>
    <WrapPanel x:Name="FocusFilters" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,14"><Button Content="All downloads" Click="FocusFilterClick"/><Button Content="Downloading" Click="FocusFilterClick"/><Button Content="Paused" Click="FocusFilterClick"/><Button Content="Needs attention" Click="FocusFilterClick"/><Button Content="Completed" Click="FocusFilterClick"/><Button Content="Connect browser" Click="BrowserClick"/><Button Content="Settings" Click="OptionsClick"/></WrapPanel>
    <StackPanel x:Name="BulkActions" DockPanel.Dock="Top" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Resume selected" Click="ResumeClick"/><Button Content="Pause selected" Click="PauseClick"/><Button Content="More…" Click="BulkMoreClick"/></StackPanel>
    <Grid x:Name="ContentGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="DetailsRow" Height="Auto"/></Grid.RowDefinitions>
     <Grid x:Name="ListPanel">
      <DataGrid x:Name="Downloads" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderThickness="0" RowHeight="76" SelectionChanged="SelectionChanged" MouseDoubleClick="DownloadDoubleClick" EnableRowVirtualization="True" EnableColumnVirtualization="True">
       <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Canvas}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/></Style><Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/></Trigger></Style.Triggers></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
       <DataGrid.Columns><DataGridTemplateColumn Header="File" Width="2*" MinWidth="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10" VerticalAlignment="Center"><TextBlock Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/><TextBlock Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Progress" Width="1.2*" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource StatusText}" Text="{Binding Status, Mode=OneWay}" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Percentage, Mode=OneWay}" FontSize="11"/></Grid><ProgressBar Style="{StaticResource TransferProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,9,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Speed / time left" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10" VerticalAlignment="Center"><TextBlock Text="{Binding Speed, Mode=OneWay}"/><TextBlock Text="{Binding Remaining, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Action" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding ActionLabel, Mode=OneWay}" Click="RowActionClick" Tag="{Binding}" Padding="9,7"/><Button ContentTemplate="{StaticResource MoreIcon}" Click="RowMoreClick" Tag="{Binding}" Padding="7" AutomationProperties.Name="More download actions"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
      </DataGrid>
      <ListBox x:Name="FocusDownloads" Visibility="Collapsed" ItemTemplate="{StaticResource FocusRow}" SelectionChanged="FocusSelectionChanged" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Frame" BorderThickness="1" BorderBrush="Transparent" CornerRadius="10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
      <Border x:Name="EmptyState" Background="{DynamicResource Canvas}" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Your downloads start here" FontSize="21" TextAlignment="Center"/><TextBlock Text="Add a URL or send a link from your browser." Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
     </Grid>
     <Border x:Name="DetailsPanel" Grid.Row="1" Margin="0,18,0,0" Padding="18" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Download details" FontWeight="SemiBold"/><TextBlock x:Name="SelectionTitle" Text="Select a download" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SelectionDetail" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="SelectionProgress" Margin="0,10,0,0"/><TextBlock x:Name="SelectionResume" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SelectionTiming" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="SelectionHash" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="Open folder" Click="FolderClick" Style="{StaticResource QuietButton}"/><Button Content="Update link" Click="ReplaceClick" Style="{StaticResource QuietButton}"/><Button Content="Advanced details" Click="DetailsClick" Style="{StaticResource QuietButton}"/></WrapPanel></StackPanel></ScrollViewer></Border>
    </Grid>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
